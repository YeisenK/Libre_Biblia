{
  "name": "@bc/ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Ingesta de textos bíblicos de dominio público: descarga, conversión, validación y carga en Postgres",
  "scripts": {
    "download": "tsx src/cli.ts download",
    "convert": "tsx src/cli.ts convert",
    "validate": "tsx src/cli.ts validate",
    "load": "tsx src/cli.ts load",
    "ingest": "tsx src/cli.ts ingest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bc/db": "workspace:*",
    "@bc/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
