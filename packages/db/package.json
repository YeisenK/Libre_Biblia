{
  "name": "@bc/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": { "@prisma/client": "^6.1.0", "@bc/shared": "workspace:*" },
  "devDependencies": { "prisma": "^6.1.0", "dotenv-cli": "^8.0.0", "tsx": "^4.19.2", "typescript": "^5.7.2", "@types/node": "^22.10.2" }
}
