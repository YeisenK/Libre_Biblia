// Biblia Católica — modelo de datos (Fases 1–3).
// El diseño completo (fases 4–8) está en docs/DATA_MODEL.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, vector]
}

// ───────────────────────── Procedencia y licencias ─────────────────────────

/// Todo contenido de terceros referencia una Source: licencia + procedencia.
model Source {
  id            String    @id @default(cuid())
  key           String    @unique // p. ej. "ebible:latVUC"
  name          String
  license       String // texto literal declarado por la fuente
  licenseUrl    String?
  provenanceUrl String?
  retrievedAt   DateTime?
  checksum      String? // sha256 del archivo original
  notes         String?
  createdAt     DateTime  @default(now())

  bibleVersions BibleVersion[]
}

// ───────────────────────────────── Biblia ──────────────────────────────────

enum Testament {
  OT
  NT
}

/// Libro del canon (73). Independiente de la traducción.
model BibleBook {
  id               Int       @id // orden canónico 1..73
  osis             String    @unique
  testament        Testament
  group            String
  deuterocanonical Boolean   @default(false)
  nameEs           String
  nameEn           String
  nameLa           String
  abbrEs           String

  verses   BibleVerse[]
  chapters BibleChapter[]
}

model BibleVersion {
  id            String   @id @default(cuid())
  code          String   @unique // "VULG", "DRA", "SCIO"...
  name          String
  language      String // BCP-47: es, la, en
  edition       String?
  versification String   @default("vulgate")
  /// Configuración de búsqueda de texto completo de Postgres
  tsConfig      String   @default("simple")
  completeness  String   @default("complete") // complete | partial
  isPublished   Boolean  @default(true)
  sourceId      String
  source        Source   @relation(fields: [sourceId], references: [id])
  importedAt    DateTime @default(now())

  chapters  BibleChapter[]
  verses    BibleVerse[]
  bookmarks Bookmark[]
}

/// Capítulos presentes por versión (para navegación y validación).
model BibleChapter {
  id         Int          @id @default(autoincrement())
  versionId  String
  version    BibleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  bookId     Int
  book       BibleBook    @relation(fields: [bookId], references: [id])
  chapter    Int
  verseCount Int

  @@unique([versionId, bookId, chapter])
}

model BibleVerse {
  id        Int          @id @default(autoincrement())
  versionId String
  version   BibleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  bookId    Int
  book      BibleBook    @relation(fields: [bookId], references: [id])
  chapter   Int
  verse     Int
  text      String
  /// Columna generada en la migración: to_tsvector(ts_config, text)
  tsConfig  String       @map("ts_config")
  tsv       Unsupported("tsvector")?

  @@unique([versionId, bookId, chapter, verse])
  @@index([bookId, chapter, verse])
}

/// Correspondencias entre esquemas de versificación (p. ej. Sal 22 hebreo ↔ Sal 21 Vulgata).
model VerseMapping {
  id           Int    @id @default(autoincrement())
  fromScheme   String
  toScheme     String
  fromKey      String // "Ps.22.1"
  toKey        String
  sourceNote   String?

  @@unique([fromScheme, toScheme, fromKey])
}

// ──────────────────────────── Usuarios y sesiones ───────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  bookmarks        Bookmark[]
  readingHistory   ReadingHistory[]
  readingPosition  ReadingPosition?
  settings         UserSettings?
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // sha256 del token opaco
  familyId   String // rotación: reutilizar un token revocado invalida la familia
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?

  @@index([userId])
  @@index([familyId])
}

model UserSettings {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme          String   @default("system") // light | dark | sepia | system
  fontScale      Float    @default(1)
  lineHeight     Float    @default(1.7)
  margin         String   @default("normal")
  readingMode    String   @default("chapter") // chapter | verse | continuous
  defaultVersion String?
  parallelVersions String[] @default([])
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────── Lectura personal ──────────────────────────────

model Bookmark {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionId String?
  version   BibleVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  bookOsis  String
  chapter   Int
  verse     Int?
  label     String?
  createdAt DateTime      @default(now())

  @@unique([userId, bookOsis, chapter, verse])
  @@index([userId, createdAt])
}

model ReadingHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionCode String
  bookOsis    String
  chapter     Int
  readAt      DateTime @default(now())

  @@index([userId, readAt(sort: Desc)])
}

/// Última posición por usuario (continuar leyendo). Una por usuario.
model ReadingPosition {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionCode String
  bookOsis    String
  chapter     Int
  verse       Int?
  updatedAt   DateTime @updatedAt
}
