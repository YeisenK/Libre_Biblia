# --- Base de datos ---
POSTGRES_USER=biblia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=biblia
DATABASE_URL=postgresql://biblia:change-me@localhost:5433/biblia?schema=public

# --- Redis (caché y colas) ---
REDIS_URL=redis://localhost:6380

# --- Almacenamiento S3 compatible (MinIO en local) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=biblia-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio

# --- API ---
API_PORT=4000
# Genera con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- IA (Fase 8, aún no usado) ---
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
EMBEDDINGS_PROVIDER=
